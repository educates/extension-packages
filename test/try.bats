#!/usr/bin/env bats

bats_require_minimum_version 1.5.0

load helpers

setup() {
  setup_scratch_repo
}

@test "try without a package fails with the usage and publishes nothing" {
  run "$SCRIPT" try --no-deploy

  [ "$status" -ne 0 ]
  [ "${lines[0]}" = "Error: try needs at least one package" ]
  [[ "$output" == *"Usage: package.sh"* ]]
  [ ! -e "$REPO/packages/hello/linux-amd64" ]
}

@test "try fails on an unknown package, listing the packages, and publishes nothing" {
  run "$SCRIPT" try --no-deploy hello nope

  [ "$status" -ne 0 ]
  [ "$output" = 'Error: unknown package "nope", expected one of: hello' ]
  [ ! -e "$REPO/packages/hello/linux-amd64" ]
}

@test "try --no-deploy --output publishes a package and writes a workshop declaring it" {
  require_local_registry
  local dir=$BATS_TEST_TMPDIR/workshop

  run "$SCRIPT" try --no-deploy --output "$dir" hello

  [ "$status" -eq 0 ]
  [[ "$output" == *"Package image: localhost:5001/hello:1.0.0"* ]]
  [[ "$output" == *'Publishing workshop files to "localhost:5001/try-hello-files:latest".'* ]]
  [ "$(list_files "$dir")" = "$(cat <<'EOF'
644 resources/workshop.yaml
644 workshop/content/00-packages.md
EOF
)" ]
  [ "$(cat "$dir/resources/workshop.yaml")" = "$(cat <<'EOF'
apiVersion: training.educates.dev/v1beta1
kind: Workshop
metadata:
  name: "try-hello"
spec:
  title: "Try hello"
  description: "Generated by package.sh try to try the extension packages hello."
  publish:
    image: "$(image_repository)/try-hello-files:$(workshop_version)"
  workshop:
    files:
    - image:
        url: "$(image_repository)/try-hello-files:$(workshop_version)"
      includePaths:
      - /workshop/**
    packages:
    - name: hello
      image: "$(image_repository)/hello:1.0.0"
      imagePullPolicy: Always
  session:
    resources:
      memory: 3Gi
    namespaces:
      security:
        token:
          enabled: false
    applications:
      terminal:
        enabled: true
        layout: split
      editor:
        enabled: true
      console:
        enabled: false
      docker:
        enabled: false
      registry:
        enabled: false
      slides:
        enabled: false
      vcluster:
        enabled: false
EOF
)" ]
  [ "$(sed -n 2p "$dir/workshop/content/00-packages.md")" = "title: Packages" ]
  [ "$(page_commands "$dir/workshop/content/00-packages.md")" = "$(cat <<'EOF'
cat /opt/packages/hello/package.yaml
ls -l /opt/packages/hello/bin
grep '^Package hello: ' ~/.local/share/workshop/download-workshop.log
EOF
)" ]
}

@test "try writes a workshop for two packages in name order, with the validation page there is" {
  require_local_registry
  local dir=$BATS_TEST_TMPDIR/workshop
  add_fixture_package notes

  run "$SCRIPT" try --no-deploy --output "$dir" notes hello

  [ "$status" -eq 0 ]
  [[ "$output" == *"Package image: localhost:5001/hello:1.0.0"* ]]
  [[ "$output" == *"Package image: localhost:5001/notes:2.0.0"* ]]
  [[ "$output" == *'Publishing workshop files to "localhost:5001/try-hello-notes-files:latest".'* ]]
  [ "$(list_files "$dir")" = "$(cat <<'EOF'
644 resources/workshop.yaml
644 workshop/content/00-packages.md
644 workshop/content/01-notes.md
EOF
)" ]
  [ "$(generated_workshop_name "$dir")" = try-hello-notes ]
  [ "$(declared_packages "$dir/resources/workshop.yaml")" = "$(cat <<'EOF'
    - name: hello
      image: "$(image_repository)/hello:1.0.0"
      imagePullPolicy: Always
    - name: notes
      image: "$(image_repository)/notes:2.0.0"
      imagePullPolicy: Always
EOF
)" ]
  [ "$(page_commands "$dir/workshop/content/00-packages.md")" = "$(cat <<'EOF'
cat /opt/packages/hello/package.yaml
ls -l /opt/packages/hello/bin
grep '^Package hello: ' ~/.local/share/workshop/download-workshop.log
cat /opt/packages/notes/package.yaml
ls -l /opt/packages/notes/bin
grep '^Package notes: ' ~/.local/share/workshop/download-workshop.log
EOF
)" ]
  [ "$(cat "$dir/workshop/content/01-notes.md")" = "$(cat "$FIXTURES/more-packages/notes/workshop.md")" ]
}

@test "try follows the packages page with each validation page in package name order" {
  require_local_registry
  local dir=$BATS_TEST_TMPDIR/workshop
  add_fixture_package notes
  printf -- '---\ntitle: hello\n---\n\nSay hello.\n' > "$REPO/packages/hello/workshop.md"

  run "$SCRIPT" try --no-deploy --output "$dir" notes hello notes

  [ "$status" -eq 0 ]
  [ "$(cd "$dir/workshop/content" && ls)" = "$(printf '00-packages.md\n01-hello.md\n02-notes.md')" ]
  [ "$(cat "$dir/workshop/content/01-hello.md")" = "$(cat "$REPO/packages/hello/workshop.md")" ]
  [ "$(cat "$dir/workshop/content/02-notes.md")" = "$(cat "$REPO/packages/notes/workshop.md")" ]
  [ "$(generated_workshop_name "$dir")" = try-hello-notes ]
}

@test "try shortens a long workshop name with a hash, to a DNS label a cluster deploy accepts" {
  require_local_registry
  # A cluster deploy names the workshop educates-cli--<name>-<7 hex>, a
  # label value, which is at most 63 characters, so <name> is at most 41.
  local here=a-package-whose-name-is-cut-at-a-hyphen-here
  local there=a-package-whose-name-is-cut-at-a-hyphen-there
  local first second again name
  add_fixture_package notes "$here"
  add_fixture_package notes "$there"

  run "$SCRIPT" try --no-deploy --output "$BATS_TEST_TMPDIR/first" "$here"
  [ "$status" -eq 0 ]
  first=$(generated_workshop_name "$BATS_TEST_TMPDIR/first")
  [[ "$output" == *"Publishing workshop files to \"localhost:5001/$first-files:latest\"."* ]]

  run "$SCRIPT" try --no-deploy --output "$BATS_TEST_TMPDIR/second" "$there"
  [ "$status" -eq 0 ]
  second=$(generated_workshop_name "$BATS_TEST_TMPDIR/second")

  run "$SCRIPT" try --no-deploy --output "$BATS_TEST_TMPDIR/again" "$here"
  [ "$status" -eq 0 ]
  again=$(generated_workshop_name "$BATS_TEST_TMPDIR/again")

  for name in "$first" "$second"; do
    [ "${#name}" -le 41 ]
    [[ "$name" =~ ^try-a-package-whose-name-[a-z0-9-]*[a-z0-9]$ ]]
  done
  [ "$first" != "$second" ]
  [ "$again" = "$first" ]
}

@test "try without --output writes the workshop to a new temporary directory and prints it" {
  require_local_registry
  local dir
  export TMPDIR=$BATS_TEST_TMPDIR/tmp
  mkdir -p "$TMPDIR"

  run --separate-stderr "$SCRIPT" try --no-deploy hello

  [ "$status" -eq 0 ]
  dir=$(printf '%s\n' "$output" | sed -n 's/^Workshop try-hello written to \(.*\)\.$/\1/p')
  [[ "$dir" == "$TMPDIR"/?* ]]
  [ "$(generated_workshop_name "$dir")" = try-hello ]
  [ -f "$dir/workshop/content/00-packages.md" ]
}

@test "try fails when --output names a directory that is not empty, and publishes nothing" {
  local dir=$BATS_TEST_TMPDIR/workshop
  mkdir -p "$dir"
  touch "$dir/keep"

  run "$SCRIPT" try --no-deploy --output "$dir" hello

  [ "$status" -ne 0 ]
  [ "$output" = "Error: $dir is not an empty directory" ]
  [ "$(ls -A "$dir")" = keep ]
  [ ! -e "$REPO/packages/hello/linux-amd64" ]
}

@test "try deploys the workshop with educates docker workshop deploy once it is published" {
  require_local_registry
  stub_educates_deploy
  local dir=$BATS_TEST_TMPDIR/workshop

  run --separate-stderr "$SCRIPT" try --output "$dir" hello

  [ "$status" -eq 0 ]
  [ "$(recorded_deploys)" = "docker workshop deploy --file $dir" ]
  [ "$(tail -n 1 "$EDUCATES_CALLS")" = "docker workshop deploy --file $dir" ]
  [[ "$(tail -n 2 "$EDUCATES_CALLS" | head -n 1)" == "workshop publish $dir"* ]]
  [ "${lines[${#lines[@]} - 1]}" = "To delete the workshop: educates docker workshop delete --file $dir" ]
}

@test "try deploys a workshop written to a relative --output by its absolute path" {
  require_local_registry
  stub_educates_deploy
  mkdir -p "$BATS_TEST_TMPDIR/cwd"
  cd "$BATS_TEST_TMPDIR/cwd"

  run --separate-stderr "$SCRIPT" try --output workshop hello

  [ "$status" -eq 0 ]
  [ "$(recorded_deploys)" = "docker workshop deploy --file $BATS_TEST_TMPDIR/cwd/workshop" ]
  [ "${lines[${#lines[@]} - 1]}" = "To delete the workshop: educates docker workshop delete --file $BATS_TEST_TMPDIR/cwd/workshop" ]
}

@test "try --package-delivery passes the delivery to educates docker workshop deploy" {
  require_local_registry
  stub_educates_deploy

  run --separate-stderr "$SCRIPT" try --package-delivery fetch --output "$BATS_TEST_TMPDIR/fetch" hello
  [ "$status" -eq 0 ]
  run --separate-stderr "$SCRIPT" try --package-delivery=image-mount --output "$BATS_TEST_TMPDIR/mount" hello
  [ "$status" -eq 0 ]

  [ "$(recorded_deploys)" = "$(cat <<EOF
docker workshop deploy --file $BATS_TEST_TMPDIR/fetch --package-delivery fetch
docker workshop deploy --file $BATS_TEST_TMPDIR/mount --package-delivery image-mount
EOF
)" ]
}

@test "try --cluster deploys the workshop with educates cluster workshop deploy" {
  require_local_registry
  stub_educates_deploy
  local dir=$BATS_TEST_TMPDIR/workshop

  run --separate-stderr "$SCRIPT" try --cluster --output "$dir" hello

  [ "$status" -eq 0 ]
  [ "$(recorded_deploys)" = "cluster workshop deploy --file $dir --open-browser" ]
  [ "$(tail -n 1 "$EDUCATES_CALLS")" = "cluster workshop deploy --file $dir --open-browser" ]
  [ "${lines[${#lines[@]} - 1]}" = "To delete the workshop: educates cluster workshop delete --file $dir" ]
}

@test "try prints a delete command that can be pasted as it is, for a path with a space" {
  require_local_registry
  stub_educates_deploy
  local docker="$BATS_TEST_TMPDIR/docker workshop"
  local cluster="$BATS_TEST_TMPDIR/cluster workshop"

  run --separate-stderr "$SCRIPT" try --output "$docker" hello
  [ "$status" -eq 0 ]
  [ "$(command_words "${lines[${#lines[@]} - 1]#To delete the workshop: }")" = "$(printf '%s\n' educates docker workshop delete --file "$docker")" ]

  run --separate-stderr "$SCRIPT" try --cluster --output "$cluster" hello
  [ "$status" -eq 0 ]
  [ "$(command_words "${lines[${#lines[@]} - 1]#To delete the workshop: }")" = "$(printf '%s\n' educates cluster workshop delete --file "$cluster")" ]
}

@test "try --no-deploy deploys nothing" {
  require_local_registry
  stub_educates_deploy

  run --separate-stderr "$SCRIPT" try --no-deploy --cluster --output "$BATS_TEST_TMPDIR/cluster" hello
  [ "$status" -eq 0 ]
  run --separate-stderr "$SCRIPT" try --no-deploy --output "$BATS_TEST_TMPDIR/docker" hello
  [ "$status" -eq 0 ]

  [ -z "$(recorded_deploys)" ]
}

@test "try fails on a package delivery other than image-mount or fetch, and publishes nothing" {
  run "$SCRIPT" try --package-delivery auto hello

  [ "$status" -ne 0 ]
  [ "${lines[0]}" = "Error: --package-delivery takes image-mount or fetch, not auto" ]
  [[ "$output" == *"Usage: package.sh"* ]]
  [ ! -e "$REPO/packages/hello/linux-amd64" ]
}

@test "try fails on --package-delivery with --cluster, and publishes nothing" {
  run "$SCRIPT" try --cluster --package-delivery fetch hello

  [ "$status" -ne 0 ]
  [ "${lines[0]}" = "Error: --package-delivery applies to a Docker deploy only, a cluster delivers packages as its EducatesClusterConfig sets" ]
  [[ "$output" == *"Usage: package.sh"* ]]
  [ ! -e "$REPO/packages/hello/linux-amd64" ]
}

@test "try --workshop-image sets the workshop image in the definition" {
  require_local_registry
  local dir=$BATS_TEST_TMPDIR/workshop

  run "$SCRIPT" try --no-deploy --output "$dir" --workshop-image 'jdk21-environment:*' hello

  [ "$status" -eq 0 ]
  [ "$(sed -n '/^  workshop:$/,/^    files:$/p' "$dir/resources/workshop.yaml")" = "$(cat <<'EOF'
  workshop:
    image: "jdk21-environment:*"
    files:
EOF
)" ]
}
